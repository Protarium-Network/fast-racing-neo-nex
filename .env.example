# Copy to .env and fill in for your deployment. All values below are
# non-secret defaults/placeholders - see globals/config.go.

# UDP port the ticket granting (authentication) server binds.
FAST_AUTHENTICATION_SERVER_PORT=26500
# UDP port the secure (game) server binds.
FAST_SECURE_SERVER_PORT=26501
# Address handed to the console so it can reach the secure server.
# Must be a LAN IP for LAN play, or a public IP/hostname for internet play.
FAST_SECURE_SERVER_HOST=127.0.0.1

# Game's 8 character hex access key. Leave unset to use the verified default.
FAST_ACCESS_KEY=811aa39f

# Password for the internal Quazal service accounts. Arbitrary, but must
# match between the authentication and secure servers.
FAST_KERBEROS_PASSWORD=fast-racing-neo

# Optional JSON file mapping NEX PIDs to fixed Kerberos passwords.
FAST_ACCOUNTS_FILE=

# 32-byte hex secret used to deterministically derive passwords for PIDs not
# listed in FAST_ACCOUNTS_FILE. Generate your own, e.g. `openssl rand -hex 32`.
# Must match whatever account server issues nex_tokens for this game.
FAST_ACCOUNT_SECRET=

# Allow any PID to authenticate via the derived password above. Set to
# false to restrict connections to PIDs listed in FAST_ACCOUNTS_FILE.
FAST_ALLOW_UNKNOWN_ACCOUNTS=true

# Directory for persistent state (leaderboards, common data).
FAST_DATA_DIR=data

# Expose sessions to browse/auto matchmaking. Disable to restrict to
# friend/invite flows only.
FAST_ALLOW_PUBLIC_MATCHMAKING=true

# Log every inbound RMC protocol/method pair. Very noisy, useful for
# reverse engineering unknown calls.
FAST_LOG_PACKETS=false

# NEX structure version/length header mode: auto | on | off.
FAST_STRUCTURE_HEADER=on

# Loopback-only HTTP port exposing live player counts. 0 disables it.
FAST_STATS_PORT=26502
